{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheLedger",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::occ-ledger-prod"
    },
    {
      "Sid": "ReadTheLedger",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::occ-ledger-prod/*"
    }
  ]
}
