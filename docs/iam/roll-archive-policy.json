{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyWhatTheBuilderWalks",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::occ-ledger-prod",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "proofs/*",
            "anchors-by-time/*",
            "roll/v1/day/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadTheLedgerItBuildsFrom",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::occ-ledger-prod/proofs/*",
        "arn:aws:s3:::occ-ledger-prod/anchors-by-time/*",
        "arn:aws:s3:::occ-ledger-prod/roll/v1/day/*"
      ]
    },
    {
      "Sid": "WriteNothingButTheArchive",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::occ-ledger-prod/roll/v1/day/*"
    }
  ]
}
