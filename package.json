{
  "name": "@mikeargento/bitgraph",
  "version": "1.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Portable cryptographic proof of construction for digital artifacts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/verify && tsc",
    "typecheck": "npm run build --workspace=packages/verify && tsc --noEmit",
    "test:core": "tsc && node --test dist/__tests__/canonical.test.js dist/__tests__/constructor.test.js dist/__tests__/verifier.test.js",
    "test": "npm run test:core"
  },
  "dependencies": {
    "@mikeargento/bitgraph-verify": "^1.0.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "workspaces": [
    "packages/verify"
  ]
}
