{
  "name": "@mikeargento/bitgraph-mcp",
  "version": "0.12.0",
  "description": "MCP server for BitGraph: make and check BitGraphs from an AI agent. Files are hashed locally; only the SHA-256 is sent.",
  "keywords": [
    "bitgraph",
    "mcp",
    "model-context-protocol",
    "ai-audit",
    "agent",
    "proof"
  ],
  "license": "MIT",
  "homepage": "https://bitgraph.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeargento/bitgraph.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "bitgraph-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/__tests__/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mikeargento/bitgraph": "^1.14.0",
    "@mikeargento/bitgraph-sdk": "^0.7.0",
    "@mikeargento/bitgraph-verify": "^1.20.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
