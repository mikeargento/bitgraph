{
  "name": "@mikeargento/bitgraph-titles",
  "version": "0.2.0",
  "description": "BitGraph Titles: possession messages, custody threads, and title abstracts over BitGraph recordings. BitGraph records. Titles convey. Player evaluates.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bitgraph-title": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "SPEC-PM.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/__tests__/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mikeargento/bitgraph-audit": "^0.1.3",
    "@mikeargento/bitgraph-player": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
