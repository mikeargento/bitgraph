{
  "name": "@mikeargento/bitgraph-verify",
  "version": "1.13.0",
  "description": "Offline verification of BitGraph proofs. Permissionless by design.",
  "keywords": [
    "bitgraph",
    "verification",
    "offline",
    "proof",
    "ed25519",
    "attestation",
    "ai-audit",
    "tamper-evident"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/__tests__/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
