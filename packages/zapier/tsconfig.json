{
  "compilerOptions": {
    "target": "ES2022",
    // node16 rather than commonjs on purpose. The app must emit CommonJS for
    // the Zapier runtime, but it loads @mikeargento/bitgraph-verify, which is
    // ESM-only. Under node16 TypeScript leaves `await import(...)` as a real
    // dynamic import in CJS output instead of rewriting it to require(), which
    // is what lets CommonJS reach an ESM package at all.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
