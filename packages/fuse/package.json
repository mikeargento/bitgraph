{
  "name": "@mikeargento/bitgraph-fuse",
  "version": "0.1.0",
  "description": "BitGraph producer SDK for fused artifacts (profile bitgraph-fuse/1, working name): allocate a slot, write a commitment to it into the artifact, hash, commit under the same slot.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/__tests__/*.test.js\""
  },
  "dependencies": {
    "@mikeargento/bitgraph-verify": "^1.4.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "bitgraph-fuse": "./dist/cli.js"
  }
}
