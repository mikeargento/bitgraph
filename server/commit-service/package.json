{
  "name": "@bitgraph/commit-service",
  "version": "1.0.0",
  "description": "BitGraph commit service — Nitro Enclave + parent HTTP server",
  "author": "Argento Computing Inc. (https://bitgraph.ing)",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm src/mock/mock-server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:enclave": "node --import tsx/esm --test src/enclave/__tests__/bind-failure.test.ts",
    "test:timeline": "node --import tsx/esm --test src/parent/__tests__/timeline-records.test.ts src/parent/__tests__/timeline-alerts.test.ts src/parent/__tests__/epoch-end.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sns": "^3.1075.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "@bitgraph/adapter-nitro": "file:../../packages/adapter-nitro",
    "@bitgraph/stub": "file:../../packages/stub",
    "cbor2": "^1.0.0",
    "bitgraph": "file:../../",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
